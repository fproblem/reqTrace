# Образец конфигурации. Скопируйте в reqtrace/.env и заполните значения:
#   cp .env.example .env
# Файл .env не коммитится (см. .gitignore) — в нём живут секреты.

# --- База данных ---
POSTGRES_PASSWORD=change_me

# --- Шифрование кред проектов (релиз v1.5.1) ---
# Пароли Confluence участников хранятся в БД зашифрованными (Fernet).
# Сгенерировать ключ: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠ Потеря/смена ключа = сохранённые пароли нечитаемы, участники вводят их заново.
CREDENTIALS_KEY=

# --- Авторизация Google OAuth (релиз v1.5.0) ---
# Client ID типа Web application из Google Cloud Console (не секрет).
GOOGLE_CLIENT_ID=
# Ключ подписи сессионных JWT. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=
# Домен, которому разрешён вход.
ALLOWED_EMAIL_DOMAIN=surf.dev
# Время жизни сессии в днях.
SESSION_TTL_DAYS=7
# true в проде (https), false локально — иначе cookie не поставится на http.
COOKIE_SECURE=false

# --- Плановое автообновление (релиз v1.6.2) ---
# Ночной прогон refresh по всем проектам + почасовой добор проектов,
# оставшихся без успешного прогона (например, Confluence был недоступен).
# Значения ниже — дефолты; блок можно не заполнять вовсе.
AUTO_REFRESH_ENABLED=true
# Время старта — в зоне AUTO_REFRESH_TZ (контейнер живёт в UTC,
# без явной зоны «03:00» превратилось бы в 06:00 МСК).
AUTO_REFRESH_AT=03:00
AUTO_REFRESH_TZ=Europe/Moscow
# Пауза между запросами к Confluence внутри прогона, мс.
AUTO_REFRESH_PAGE_DELAY_MS=300
